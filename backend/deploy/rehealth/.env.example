REHEALTH_RUNTIME_MODE=development
REHEALTH_RELEASE_TAG=local
REHEALTH_EDGE_BIND=127.0.0.1
REHEALTH_EDGE_PORT=8080
REHEALTH_MODEL_ARTIFACT_DIR=./artifacts
# Put the provider API key in secrets/provider_credential (one line, no quotes).
# Never put the API key in this file, Android local.properties, or tracked YAML.
REHEALTH_AGENT_PROVIDER_ENABLED=true
REHEALTH_AGENT_PROVIDER_BASE_URL=https://api.deepseek.com
REHEALTH_AGENT_PROVIDER_MODEL=deepseek-v4-flash
# Health chat runs in JeecgBoot through Java LangChain4j. Use model-service only for an explicit rollback.
# Apply software-V20260730.1 and provision provider_credential before startup.
REHEALTH_HEALTH_AGENT_ENGINE=langchain4j
REHEALTH_LLM_BASE_URL=https://api.deepseek.com
REHEALTH_LLM_MODEL=deepseek-v4-flash
# Photo records use a separate multimodal provider credential in
# secrets/vision_provider_credential. The Android app never receives this key.
REHEALTH_VISION_ENABLED=false
REHEALTH_VISION_BASE_URL=https://api.openai.com/v1
REHEALTH_VISION_MODEL=gpt-5.6-luna
REHEALTH_VISION_TIMEOUT_SECONDS=75
# Optional local-development proxy for JeecgBoot outbound HTTPS provider calls.
# Use a host and port only; do not include a URL scheme or credentials.
REHEALTH_JEECG_HTTPS_PROXY_ENABLED=false
REHEALTH_JEECG_HTTPS_PROXY_HOST=127.0.0.1
REHEALTH_JEECG_HTTPS_PROXY_PORT=7897
# Local development keeps the fixed 123456 code. Production must set this to false,
# enable Aliyun SMS, and provide approved sign/template values below. AccessKey values
# belong only in secrets/aliyun_sms_access_key_id and secrets/aliyun_sms_access_key_secret.
JEECG_SMS_DEV_MODE=true
JEECG_SMS_ALIYUN_ENABLED=false
JEECG_SMS_ALIYUN_SIGN_NAME=
JEECG_SMS_ALIYUN_REGISTER_TEMPLATE_CODE=
JEECG_SMS_ALIYUN_LOGIN_TEMPLATE_CODE=
JEECG_SMS_ALIYUN_CHANGE_PASSWORD_TEMPLATE_CODE=
