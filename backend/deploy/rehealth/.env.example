REHEALTH_RUNTIME_MODE=development
REHEALTH_RELEASE_TAG=local
REHEALTH_EDGE_BIND=127.0.0.1
REHEALTH_EDGE_PORT=8080
REHEALTH_MODEL_ARTIFACT_DIR=./artifacts
# Put the provider API key in secrets/provider_credential (one line, no quotes).
# Never put the API key in this file, Android local.properties, or tracked YAML.
REHEALTH_AGENT_PROVIDER_ENABLED=true
REHEALTH_AGENT_PROVIDER_BASE_URL=https://api.deepseek.com
REHEALTH_AGENT_PROVIDER_MODEL=deepseek-v4-flash
# Java health chat defaults to the existing Python boundary for rollback safety.
# Set to langchain4j after applying software-V20260730.1 and provisioning provider_credential.
REHEALTH_HEALTH_AGENT_ENGINE=model-service
REHEALTH_LLM_BASE_URL=https://api.deepseek.com
REHEALTH_LLM_MODEL=deepseek-v4-flash
