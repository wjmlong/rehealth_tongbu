{
  "openapi": "3.1.0",
  "info": {
    "title": "ReHealth Android-compatible Mobile API",
    "version": "1.4.0",
    "description": "Frozen public contract. Gateway target changes must preserve these paths and serialized DTO fields."
  },
  "servers": [{"url": "/jeecg-boot"}],
  "security": [{"XAccessToken": []}],
  "paths": {
    "/rehealth/mobile/health": {"get": {"security": [], "x-response-dto": "HealthResponseDto", "responses": {"200": {"description": "HealthResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/config": {"get": {"x-response-dto": "MobileConfigResponseDto", "responses": {"200": {"description": "MobileConfigResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/profile": {
      "get": {"x-response-dto": "PatientProfileDto", "responses": {"200": {"description": "PatientProfileDto in Jeecg Result envelope"}}},
      "put": {"x-request-dto": "PatientProfileDto", "x-response-dto": "PatientProfileDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PatientProfileDto"}}}}, "responses": {"200": {"description": "PatientProfileDto in Jeecg Result envelope"}}}
    },
    "/rehealth/mobile/interviews": {"post": {"x-request-dto": "HealthInterviewSubmitRequestDto", "x-response-dto": "HealthInterviewSubmitRequestDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthInterviewSubmitRequestDto"}}}}, "responses": {"200": {"description": "Persisted interview in Jeecg Result envelope"}}}},
    "/rehealth/mobile/interviews/latest": {"get": {"x-response-dto": "HealthInterviewSubmitRequestDto", "responses": {"200": {"description": "Latest interview in Jeecg Result envelope"}}}},
    "/rehealth/mobile/devices/bind": {"post": {"x-request-dto": "DeviceBindRequestDto", "x-response-dto": "DeviceBindResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeviceBindRequestDto"}}}}, "responses": {"200": {"description": "DeviceBindResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/viomi/bind": {"post": {"x-request-dto": "ViomiBindRequestDto", "x-response-dto": "ViomiBindResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViomiBindRequestDto"}}}}, "responses": {"200": {"description": "Authenticated Viomi IMEI binding"}}}},
    "/rehealth/mobile/viomi/sync": {"post": {"x-request-dto": "ViomiSyncRequestDto", "x-response-dto": "ViomiSyncResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViomiSyncRequestDto"}}}}, "responses": {"200": {"description": "Persisted Viomi history window"}}}},
    "/rehealth/mobile/insurance/plans/bind": {"post": {"x-request-dto": "InsurancePlanBindRequestDto", "x-response-dto": "InsurancePlanBindingDto", "description": "Binds the authenticated APP user to an active tenant policy after tenant-scoped service enrollment and consent validation; APP users are not required to be backend tenant members.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InsurancePlanBindRequestDto"}}}}, "responses": {"200": {"description": "Privacy-safe InsurancePlanBindingDto in Jeecg Result envelope"}, "403": {"description": "Service enrollment, tenant, policy or consent scope does not match"}}}},
    "/rehealth/mobile/insurance/plans/current": {"get": {"x-response-dto": "InsurancePlanBindingDto", "description": "Returns the current tenant's active binding while subject enrollment, tenant, policy and consent remain active.", "responses": {"200": {"description": "Current active privacy-safe plan binding"}, "404": {"description": "No active tenant-scoped plan binding"}}}},
    "/rehealth/mobile/insurance/plans/active": {"get": {"x-response-dto": "InsurancePlanBindingDto", "description": "Returns an array of every active insurance binding for the authenticated APP user across active insurance service relationships.", "responses": {"200": {"description": "Tenant-tagged privacy-safe plan binding array in Jeecg Result envelope"}}}},
    "/rehealth/mobile/insurance/plans/{bindingId}/feedback": {"post": {"x-request-dto": "InsurancePlanFeedbackRequestDto", "description": "Accepts binding-specific plan-item facts only while the subject enrollment, tenant, policy, consent and binding remain active. The server derives adherence from completedCount / expectedCount and ignores client-computed scores.", "parameters": [{"name": "bindingId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InsurancePlanFeedbackRequestDto"}}}}, "responses": {"200": {"description": "Idempotent feedback receipt with server-derived adherence in Jeecg Result envelope"}, "403": {"description": "Binding is not owned by the authenticated user, or policy/consent/tenant is inactive"}}}},
    "/rehealth/mobile/measurements/batch": {"post": {"x-request-dto": "TelemetryBatchRequestDto", "x-response-dto": "TelemetryBatchResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TelemetryBatchRequestDto"}}}}, "responses": {"200": {"description": "Durable ingest receipt in Jeecg Result envelope"}, "503": {"description": "Persistence unavailable; retry the same batchId"}}}},
    "/rehealth/mobile/measurements/recent": {"get": {"x-response-dto": "RecentTelemetryResponseDto", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 50}}], "responses": {"200": {"description": "RecentTelemetryResponseDto in Jeecg Result envelope"}, "503": {"description": "Telemetry query unavailable"}}}},
    "/rehealth/mobile/features/evaluate": {"post": {"x-request-dto": "RiskEvaluateRequestDto", "x-response-dto": "RiskEvaluateResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RiskEvaluateRequestDto"}}}}, "responses": {"200": {"description": "RiskEvaluateResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/rhi/evaluate-series": {"post": {"description": "Research-preview chronological RHI recalculation through model-service; does not replace the production CVD risk path.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object"}}}}, "responses": {"200": {"description": "RHI series JSON in Jeecg Result envelope"}, "400": {"description": "Invalid RHI series request"}, "503": {"description": "Model service unavailable"}}}},
    "/rehealth/mobile/rhi/manual-inputs": {"get": {"x-response-dto": "RhiManualHealthInputDto", "responses": {"200": {"description": "Authenticated user manual RHI inputs, or null"}}}, "put": {"x-request-dto": "RhiManualHealthInputDto", "x-response-dto": "RhiManualHealthInputDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RhiManualHealthInputDto"}}}}, "responses": {"200": {"description": "Persisted or newer existing manual RHI inputs"}}}},
    "/rehealth/mobile/risk/latest": {"get": {"x-response-dto": "RiskEvaluateResponseDto", "responses": {"200": {"description": "Latest RiskEvaluateResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/risk/history": {"get": {"description": "Returns the authenticated user's bounded persisted CVD risk history for trend display.", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 90, "minimum": 2, "maximum": 365}}], "responses": {"200": {"description": "Chronological attribution history point array in Jeecg Result envelope"}}}},
    "/rehealth/mobile/interventions/generate": {"post": {"x-request-dto": "InterventionGenerateRequestDto", "x-response-dto": "InterventionGenerateResponseDto", "description": "Reloads authenticated server-side profile, interview, latest risk and tenant-scoped Device Service telemetry context before LangChain4j generation. Client health-context fields are ignored.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InterventionGenerateRequestDto"}}}}, "responses": {"200": {"description": "Persisted structured InterventionGenerateResponseDto in Jeecg Result envelope"}, "503": {"description": "Authoritative context, LLM provider, or software persistence unavailable; no fallback plan"}}}},
    "/rehealth/mobile/interventions/today": {"get": {"x-response-dto": "InterventionGenerateResponseDto", "responses": {"200": {"description": "Latest InterventionGenerateResponseDto in Jeecg Result envelope"}}}},
    "/rehealth/mobile/interventions/{id}/feedback": {"post": {"x-request-dto": "FeedbackRequestDto", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FeedbackRequestDto"}}}}, "responses": {"200": {"description": "Feedback receipt map in Jeecg Result envelope"}, "403": {"description": "Intervention is not owned by authenticated user"}}}},
    "/rehealth/mobile/attribution/events": {"post": {"x-request-dto": "AttributionEventsRequestDto", "x-response-dto": "AttributionResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AttributionEventsRequestDto"}}}}, "responses": {"200": {"description": "AttributionResponseDto with explicit provenance/status"}}}},
    "/rehealth/mobile/agent/messages": {"post": {"x-request-dto": "HealthAgentMessageRequestDto", "x-response-dto": "HealthAgentResponseDto", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthAgentMessageRequestDto"}}}}, "responses": {"200": {"description": "Persisted health-agent response in Jeecg Result envelope"}, "409": {"description": "requestId was reused with different content"}, "429": {"description": "Per-user health-agent rate limit exceeded"}, "503": {"description": "Health-agent engine or persistence is unavailable"}}}},
    "/rehealth/mobile/agent/conversations/latest": {"get": {"x-response-dto": "HealthAgentConversationDto", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "default": 100, "minimum": 1, "maximum": 200}}], "responses": {"200": {"description": "Latest user-and-tenant-scoped conversation, or null"}}}},
    "/rehealth/mobile/behavior-records/analyze-photo": {"post": {"x-response-dto": "BehaviorRecordDto", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["image", "requestId", "occurredAt"], "properties": {"image": {"type": "string", "contentMediaType": "image/jpeg", "contentEncoding": "binary"}, "requestId": {"type": "string", "maxLength": 128}, "occurredAt": {"type": "integer", "format": "int64"}}}}}}, "responses": {"200": {"description": "Persisted AI-analyzed behavior record in Jeecg Result envelope"}, "400": {"description": "Invalid image, type, size, or request fields"}, "503": {"description": "Vision provider or software persistence unavailable"}}}},
    "/rehealth/mobile/behavior-records/today": {"get": {"parameters": [{"name": "date", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}, {"name": "zoneOffsetMinutes", "in": "query", "schema": {"type": "integer", "default": 480, "minimum": -1080, "maximum": 1080}}], "responses": {"200": {"description": "Current owner BehaviorRecordDto array for the requested local calendar day"}, "503": {"description": "Software persistence unavailable"}}}}
  },
  "components": {
    "securitySchemes": {"XAccessToken": {"type": "apiKey", "in": "header", "name": "X-Access-Token"}},
    "schemas": {
      "PatientProfileDto": {"type": "object", "description": "Authenticated user-scoped profile. BMI and updatedAt are server managed; version is returned for optimistic concurrency control.", "properties": {"patientId": {}, "name": {"type": "string", "maxLength": 128}, "gender": {"type": "string", "enum": ["male", "female"]}, "age": {"type": "integer", "minimum": 1, "maximum": 120}, "heightCm": {"type": "number", "minimum": 50, "maximum": 250}, "weightKg": {"type": "number", "minimum": 2, "maximum": 500}, "bmi": {"type": "number", "readOnly": true}, "diagnoses": {"type": "array", "maxItems": 100, "items": {"type": "string"}}, "medications": {"type": "array", "maxItems": 100, "items": {"type": "string"}}, "allergies": {"type": "array", "maxItems": 100, "items": {"type": "string"}}, "familyHistory": {"type": "boolean"}, "smoking": {"type": "boolean"}, "drinking": {"type": "boolean"}, "diabetesHistory": {"type": "boolean"}, "hypertensionHistory": {"type": "boolean"}, "updatedAt": {"type": "integer", "format": "int64", "readOnly": true}, "version": {"type": "integer", "format": "int64", "description": "Send the latest returned value when updating an existing profile."}}},
      "HealthInterviewSubmitRequestDto": {"type": "object", "properties": {"profile": {"$ref": "#/components/schemas/PatientProfileDto"}, "answers": {}, "baselineItems": {}, "focusAreas": {}, "generatedAt": {}}},
      "DeviceBindRequestDto": {"type": "object", "properties": {"deviceId": {}, "deviceName": {}, "manufacturer": {}, "model": {}, "firmwareVersion": {}, "hardwareAddressHash": {}}},
      "ViomiBindRequestDto": {"type": "object", "properties": {"imei": {"type": "string"}, "productCode": {"type": "string"}}},
      "ViomiBindResponseDto": {"type": "object", "properties": {"deviceId": {}, "imeiMasked": {}, "productCode": {}, "deviceModel": {}, "status": {}}},
      "ViomiSyncRequestDto": {"type": "object", "properties": {"deviceId": {}, "from": {}, "to": {}}},
      "ViomiSyncResponseDto": {"type": "object", "properties": {"deviceId": {}, "from": {}, "to": {}, "measurements": {}, "persistedCount": {}, "warnings": {}}},
      "RhiManualHealthInputDto": {"type": "object", "description": "Authenticated user-scoped nullable manual RHI health inputs.", "properties": {"sedentaryHoursPerDay": {}, "waistCircumferenceCm": {}, "vo2MaxLab": {}, "hba1cPercent": {}, "egfrMlMin173m2": {}, "cuffSbp7dMean": {}, "cuffDbp7dMean": {}, "ldlMmolL": {}, "hdlMmolL": {}, "triglyceridesMmolL": {}, "fastingGlucoseMmolL": {}, "hba1cObservedAt": {}, "egfrObservedAt": {}, "lipidsObservedAt": {}, "fastingGlucoseObservedAt": {}, "updatedAt": {}}},
      "InsurancePlanBindRequestDto": {"type": "object", "required": ["tenantId", "policyNo", "planId", "consentVersion", "sourceRecordId"], "properties": {"tenantId": {"type": "string"}, "policyNo": {"type": "string"}, "planId": {"type": "string"}, "consentVersion": {"type": "string"}, "consentType": {"type": "string", "default": "insurance_health_program"}, "evidenceRef": {"type": ["string", "null"]}, "evidenceHash": {"type": ["string", "null"]}, "sourceRecordId": {"type": "string"}, "metadata": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "InsurancePlanBindingDto": {"type": "object", "description": "Privacy-safe plan binding; contains no raw health data or direct identifiers.", "properties": {"tenantId": {"type": "integer"}, "bindingId": {"type": "string"}, "subjectRef": {"type": "string"}, "policyId": {"type": "string"}, "policyNo": {"type": "string"}, "planId": {"type": "string"}, "consentId": {"type": "string"}, "consentVersion": {"type": "string"}, "status": {"type": "string"}, "boundAt": {"type": "string", "format": "date-time"}}},
      "InsurancePlanFeedbackRequestDto": {"type": "object", "required": ["feedbackType", "occurredAt", "sourceRecordId", "planItemId"], "properties": {"feedbackType": {"type": "string", "enum": ["completed", "partially_completed", "skipped", "not_applicable"]}, "occurredAt": {"type": "string", "description": "Jeecg local date-time: yyyy-MM-dd HH:mm:ss"}, "completionRate": {"type": ["number", "null"], "deprecated": true, "description": "Compatibility input ignored for authoritative adherence calculation."}, "adherenceScore": {"type": ["number", "null"], "deprecated": true, "description": "Compatibility input ignored for authoritative adherence calculation."}, "sourceRecordId": {"type": "string"}, "interventionId": {"type": ["string", "null"]}, "planItemId": {"type": "string", "maxLength": 128}, "expectedCount": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 366, "default": 1}, "completedCount": {"type": ["number", "null"], "minimum": 0, "maximum": 366}, "verificationType": {"type": "string", "enum": ["self_report", "device_verified", "staff_confirmed"], "default": "self_report"}, "outcomeSummary": {"type": "object", "additionalProperties": {"type": "string"}}}},
      "TelemetryBatchRequestDto": {"type": "object", "description": "telemetry-v2 Android request shape; authenticated server identity overrides userId, diet records are structured only, and raw signal/meal-image upload remains disabled.", "properties": {"schemaVersion": {"type": "string", "enum": ["d2-v1", "telemetry-v1", "telemetry-v2"]}, "batchId": {}, "userId": {}, "deviceId": {}, "collectedFrom": {}, "collectedTo": {}, "source": {}, "measurements": {}, "sleepSessions": {}, "activitySessions": {}, "dietRecords": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "consumedAt": {"type": "integer", "format": "int64"}, "mealType": {"type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"]}, "description": {"type": "string", "maxLength": 256}, "caloriesKcal": {"type": "number", "minimum": 0}, "proteinGrams": {"type": "number", "minimum": 0}, "carbohydrateGrams": {"type": "number", "minimum": 0}, "fatGrams": {"type": "number", "minimum": 0}, "fiberGrams": {"type": "number", "minimum": 0}, "sodiumMilligrams": {"type": "number", "minimum": 0}, "source": {"type": "string"}}}}, "signalChunks": {}, "quality": {}}},
      "RiskEvaluateRequestDto": {"type": "object", "properties": {"featureVector": {}, "requestId": {}}},
      "InterventionGenerateRequestDto": {"type": "object", "properties": {"request_id": {"type": "string"}, "riskResult": {}, "featureVector": {}, "patientContext": {}}},
      "FeedbackRequestDto": {"type": "object", "properties": {"status": {}, "adherence": {}, "note": {}, "checkedAt": {}}},
      "AttributionEventsRequestDto": {"type": "object", "description": "Authenticated service scopes stored history; client history is compatibility input and never establishes ownership.", "properties": {"request_id": {"type": "string"}, "risk_history": {}, "forecast_days": {}, "language": {}}},
      "HealthResponseDto": {"type": "object", "properties": {"status": {}, "service": {}, "module": {}, "modelServiceConfigured": {}, "dependencies": {}}},
      "MobileConfigResponseDto": {"type": "object", "properties": {"apiVersion": {}, "modelContract": {}, "softwareDbPersistenceEnabled": {}, "hardwareIngestEnabled": {}, "ingestMode": {}, "ingestQueueType": {}, "hardwareDbEnabled": {}, "rawSignalUploadEnabled": {}, "endpoints": {}, "limitations": {}}},
      "DeviceBindResponseDto": {"type": "object", "properties": {"deviceId": {}, "status": {}, "persisted": {}, "persistenceStage": {}}},
      "TelemetryBatchResponseDto": {"type": "object", "properties": {"batchId": {}, "receiptId": {}, "status": {}, "accepted": {}, "persisted": {}, "queued": {}, "durableQueue": {}, "hardwareDbEnabled": {}, "rawSignalUploadEnabled": {}, "ingestStage": {}, "ingestMode": {}, "queueType": {}, "recordCount": {}, "measurementCount": {}, "sleepSessionCount": {}, "activitySessionCount": {}, "dietRecordCount": {}, "signalChunkCount": {}, "rejectedCount": {}, "warnings": {}}},
      "RecentTelemetryResponseDto": {"type": "object", "properties": {"userId": {}, "limit": {}, "measurements": {}, "sleepSessions": {}, "activities": {}}},
      "RiskEvaluateResponseDto": {"type": "object", "properties": {"risk_score": {}, "risk_level": {}, "feature_contributions": {}, "factor_contributions": {}, "factor_contribution_version": {}, "factor_measured_components": {}, "factor_control_support_components": {}, "model_version": {}, "is_mock": {}, "missing_fields": {}, "quality_warnings": {}, "summary": {}, "model_trace": {}}},
      "InterventionGenerateResponseDto": {"type": "object", "properties": {"plan_id": {}, "generated_at": {}, "priority_intervention": {}, "rationale": {}, "expected_impact": {}, "contraindications": {}, "confidence": {}, "model_version": {}, "is_mock": {}, "medical_disclaimer": {}, "summary": {}, "items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object", "properties": {"id": {}, "category": {"type": "string", "enum": ["diet", "exercise", "sleep", "blood_pressure", "metabolic", "follow_up"]}, "title": {}, "action": {}, "rationale": {}, "target": {}, "timing": {}, "priority": {"type": "integer", "minimum": 1, "maximum": 5}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}}}, "focus_date": {}, "context_version": {}, "context_generated_at": {"type": "integer", "format": "int64"}, "latest_data_at": {"type": "integer", "format": "int64"}}},
      "AttributionResponseDto": {"type": "object", "properties": {"status": {}, "history_days": {}, "min_history_days": {}, "intervention_days": {}, "intervention_data_sufficient": {}, "current_state": {}, "forecast": {}, "intervention_effect": {}, "reports": {}, "model_version": {}, "attribution_mode": {}, "is_mock": {"type": "boolean"}, "provider": {}, "request_id": {"type": "string"}, "error_code": {}, "error_message": {}, "retryable": {"type": "boolean"}, "trend_delta": {}, "adherence_average": {}, "interpretation": {}}},
      "HealthAgentMessageRequestDto": {"type": "object", "required": ["requestId", "message"], "properties": {"requestId": {"type": "string", "maxLength": 128}, "conversationId": {"type": "string", "maxLength": 64}, "clientMessageId": {"type": "string", "maxLength": 64}, "message": {"type": "string", "minLength": 1, "maxLength": 1200}, "locale": {"type": "string", "default": "zh-CN"}}},
      "HealthAgentResponseDto": {"type": "object", "properties": {"request_id": {"type": "string"}, "conversationId": {"type": "string"}, "messageId": {"type": "string"}, "createdAt": {"type": "integer", "format": "int64"}, "status": {"type": "string"}, "answer": {"type": "string"}, "medical_disclaimer": {"type": "string"}, "provider": {"type": "string"}, "model_version": {"type": "string"}, "is_demo": {"type": "boolean"}, "retryable": {"type": "boolean"}}},
      "HealthAgentHistoryMessageDto": {"type": "object", "properties": {"messageId": {"type": "string"}, "requestId": {"type": "string"}, "role": {"type": "string", "enum": ["USER", "ASSISTANT"]}, "content": {"type": "string"}, "status": {"type": "string"}, "provider": {"type": "string"}, "modelVersion": {"type": "string"}, "createdAt": {"type": "integer", "format": "int64"}}},
      "HealthAgentConversationDto": {"type": "object", "properties": {"conversationId": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}, "createdAt": {"type": "integer", "format": "int64"}, "updatedAt": {"type": "integer", "format": "int64"}, "messages": {"type": "array", "items": {"$ref": "#/components/schemas/HealthAgentHistoryMessageDto"}}}},
      "BehaviorRecordDto": {"type": "object", "properties": {"id": {"type": "string"}, "requestId": {"type": "string"}, "category": {"type": "string", "enum": ["FOOD", "OCR", "OTHER"]}, "title": {"type": "string"}, "summary": {"type": "string"}, "items": {"type": "array", "items": {"type": "string"}}, "caloriesKcal": {"type": ["number", "null"]}, "proteinGrams": {"type": ["number", "null"]}, "carbohydrateGrams": {"type": ["number", "null"]}, "fatGrams": {"type": ["number", "null"]}, "ocrText": {"type": ["string", "null"]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "modelVersion": {"type": "string"}, "occurredAt": {"type": "integer", "format": "int64"}, "createdAt": {"type": "integer", "format": "int64"}}}
    }
  },
  "x-rehealth-characterization": {
    "source": "ReHealthMobileController.java, BehaviorRecordController.java, and serialized DTO annotations",
    "dtoFields": {
      "AttributionEventsRequestDto": ["Y", "Z", "date", "forecast_days", "language", "request_id", "risk_history"],
      "AttributionResponseDto": ["30d_no_action", "30d_with_plan", "adherence_average", "advice", "att_available", "att_ci_lower", "att_ci_upper", "att_p_value", "att_significant", "att_unavailable_reason", "attribution_mode", "body", "ci_lower", "ci_upper", "current_state", "dates", "error_code", "error_message", "forecast", "headline", "history_days", "individual_att", "interpretation", "intervention_data_sufficient", "intervention_days", "intervention_effect", "is_mock", "min_history_days", "model_version", "no_action", "provider", "raw", "reports", "request_id", "retryable", "risk_level", "risk_reduction", "risk_score", "status", "summary", "trend", "trend_delta", "user", "with_plan"],
      "BehaviorRecordDto": ["caloriesKcal", "carbohydrateGrams", "category", "confidence", "createdAt", "fatGrams", "id", "items", "modelVersion", "occurredAt", "ocrText", "proteinGrams", "requestId", "summary", "title"],
      "CvdFeatureVectorDto": ["age", "bmi", "dbp", "diabetes_history", "drinking", "exercise_days", "family_history", "fasting_glucose", "featureQuality", "gender", "hdl", "hypertension_history", "ldl", "sbp", "smoking", "total_cholesterol", "triglycerides"],
      "DeviceBindRequestDto": ["deviceId", "deviceName", "firmwareVersion", "hardwareAddressHash", "manufacturer", "model"],
      "DeviceBindResponseDto": ["deviceId", "persisted", "persistenceStage", "status"],
      "FeatureQualityDto": ["observedAt", "reason", "source", "status"],
      "FeedbackRequestDto": ["adherence", "checkedAt", "note", "status"],
      "HealthInterviewAnswerDto": ["content", "questionId", "topic"],
      "HealthInterviewBaselineItemDto": ["label", "value"],
      "HealthAgentConversationDto": ["conversationId", "createdAt", "messages", "status", "title", "updatedAt"],
      "HealthAgentHistoryMessageDto": ["content", "createdAt", "messageId", "modelVersion", "provider", "requestId", "role", "status"],
      "HealthAgentMessageRequestDto": ["clientMessageId", "conversationId", "locale", "message", "requestId"],
      "HealthAgentResponseDto": ["answer", "conversationId", "createdAt", "is_demo", "medical_disclaimer", "messageId", "model_version", "provider", "request_id", "retryable", "status"],
      "HealthInterviewSubmitRequestDto": ["answers", "baselineItems", "focusAreas", "generatedAt", "profile"],
      "HealthResponseDto": ["dependencies", "modelServiceConfigured", "module", "service", "status"],
      "InterventionGenerateRequestDto": ["featureVector", "patientContext", "request_id", "riskResult"],
      "InterventionGenerateResponseDto": ["action", "category", "confidence", "context_generated_at", "context_version", "contraindications", "evidenceRefs", "expected_impact", "focus_date", "generated_at", "id", "is_mock", "items", "latest_data_at", "medical_disclaimer", "model_version", "plan_id", "priority", "priority_intervention", "rationale", "summary", "target", "timing", "title"],
